# .env로 복사해서 쓰세요. (Vercel에서는 Project Settings → Environment Variables에 같은 이름으로 넣어요)
VITE_SUPABASE_URL=https://dzzkhxrlvlakaduaeyxj.supabase.co
# Supabase → Project Settings → API Keys → Legacy anon (JWT). report 함수가 JWT 검사를 켜 둬서 이 키가 필요해요.
VITE_SUPABASE_ANON_KEY=
# 실제 공공 API 공고가 들어오면 false (상단 '미리보기 · 예시 데이터' 표시가 사라져요)
VITE_SAMPLE_MODE=true
